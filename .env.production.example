# Sauron Vision — production environment.
#
#   cp .env.production.example .env    # then fill in the REQUIRED block
#
# Every key here is actually read by config/settings.py or by app code.
# (The previous version of this file documented five keys nothing read and
# omitted a dozen that were read — which is part of why deploys failed.)

# ============================================================
# REQUIRED — the stack will not start without these
# ============================================================

# Django secret. Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Broker-credential encryption key. Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#
# IMPORTANT: set this BEFORE storing broker credentials, and carry the same
# value to any new host. It is deliberately separate from SECRET_KEY so
# rotating that (or moving machines) cannot make every stored broker
# credential undecryptable. Existing credentials encrypted under the old
# SECRET_KEY-derived key still decrypt; re-save them to migrate.
FERNET_KEY=

# Your domain — Caddy requests the TLS certificate for exactly this name,
# so DNS must already point at the box.
DOMAIN=sauron.example.com
ALLOWED_HOSTS=sauron.example.com
DEBUG=False

# Postgres (used by the postgres container and by Django).
DB_NAME=sauron_vision
DB_USER=sauron
DB_PASSWORD=

# ============================================================
# AI — optional; every agent no-ops silently without a key
# ============================================================
ANTHROPIC_API_KEY=
# Model per tier. Leave blank to use the catalog defaults, or override at
# runtime in the UI at /ai-models/ (no redeploy needed).
AI_DEFAULT_PROVIDER=claude
AI_MODEL_FAST=
AI_MODEL_BALANCED=
AI_MODEL_DEEP=

# Hard daily ceiling on LLM spend in USD; 0 disables. Default 15 —
# sized for the COMPLETE AgentTask ledger (before 2026-08-24 the
# ledger missed every direct brain call and a 5 governed ~half of
# true spend).
AI_DAILY_BUDGET_USD=15
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Market data — all optional; each feed degrades independently
# ============================================================
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
MARKETAUX_API_KEY=
ETORO_API_KEY=
GLASSNODE_API_KEY=
OIL_PRICE_API_KEY=
COMMODITIES_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sauron-vision/1.0
SEC_EDGAR_USER_AGENT=Your Name your@email.com

# ============================================================
# Brokers — leave blank until you are ready to trade live
# ============================================================
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# ============================================================
# Alerts
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Email — digests, strategist briefings, newsletters. With EMAIL_HOST unset
# Django prints mail to the console instead of silently failing to send.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@sauron.example.com

# ============================================================
# Portfolio
# ============================================================
PORTFOLIO_BASE_CURRENCY=EUR
PORTFOLIO_INITIAL_CAPITAL=10000

# ============================================================
# Backups — set BACKUP_REMOTE or your backups die with the box
# ============================================================
# An rclone destination, e.g. "hetzner:sauron-backups" or "b2:my-bucket".
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ============================================================
# Error tracking — optional, no-op when unset
# ============================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Interactive Brokers (optional; one profile per LOGIN) ─────────────
# IBKR has no API key: Gateway must be logged in and listening. Start the
# slots you have credentials for:
#
#   ./deploy/dc --profile ibkr --profile ibkr2 up -d
#
# and set each user's IBKRAccount host on the admin page to the matching
# service: ibgateway, ibgateway-2, … ibgateway-5.
#
# ONE SESSION PER USERNAME. Logging into the IBKR portal or mobile app
# with the same credentials kicks that Gateway out mid-session. Accounts
# UNDER a single login do NOT need separate slots — one Gateway serves
# them all and IBKRAccount.account_id decides where each order lands.
#
# TRADING_MODE decides which account Gateway logs into; the PORT on the
# admin form decides which one Sauron talks to. They must agree:
#   paper -> 4002        live -> 4001
#
# And give each IBKRAccount a DISTINCT client_id below 100 — Sauron
# derives one socket id per purpose from it, and IBKR evicts the earlier
# holder when two connections share an id.
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TRADING_MODE=paper

IBKR2_USERNAME=
IBKR2_PASSWORD=
IBKR2_TRADING_MODE=paper

IBKR3_USERNAME=
IBKR3_PASSWORD=
IBKR3_TRADING_MODE=paper

IBKR4_USERNAME=
IBKR4_PASSWORD=
IBKR4_TRADING_MODE=paper

IBKR5_USERNAME=
IBKR5_PASSWORD=
IBKR5_TRADING_MODE=paper

# SEE THE GATEWAY'S SCREEN. IB Gateway shows a "Gateway"-titled notice box
# for server replies, account notices and marketing interstitials; the IBC
# automation in the container cannot read it and leaves it up with no
# timeout (open IBC defects #360/#382). `dc ps` shows the container as
# (unhealthy) in that state. Set a password here to start x11vnc INSIDE the
# gateway container - nothing is published to the host. From the box:
#   docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' sauron-ibgateway-1
# then from your laptop:  ssh -L 5900:<that ip>:5900 sauron@<box>
# and point any VNC viewer at localhost:5900 to read and dismiss the dialog.
# Blank keeps VNC off. Applies to every gateway slot.
IBKR_VNC_PASSWORD=

# ---- TradingView alerts (optional) ------------------------------------
# Alerts arrive as SIGNALS, never as orders: they join the same queue
# every internal rule writes into, are scored and aged the same way, and
# are refused by the same book. Leave blank and the endpoint is CLOSED.
#
# TradingView cannot send custom headers, so this secret travels in the
# alert's JSON body. Point an alert at
#   https://<your-domain>/api/webhook/tradingview/
# with the message:
#   {"secret": "...", "symbol": "{{ticker}}", "action": "buy",
#    "price": {{close}}, "stop": 0, "target": 0, "strategy": "my-rule"}
TRADINGVIEW_WEBHOOK_SECRET=
