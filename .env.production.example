# Phase-30 — production environment template (used with docker-compose.prod.yml).
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Required:    SECRET_KEY, DB_PASSWORD
# Strongly recommended: FERNET_KEY (broker-cred encryption), TELEGRAM_BOT_TOKEN, ANTHROPIC_API_KEY
# Broker creds (Binance / OANDA / Alpaca / IBKR account_id) live in DB encrypted via Fernet — not here.

# ── Django ─────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-50-char-random-from-django-utils-crypto-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=sauron.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://sauron.example.com

# Fernet key for broker-credential at-rest encryption.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Database (PostgreSQL service in compose) ───────────────────────────
DB_NAME=sauron_vision
DB_USER=sauron
DB_PASSWORD=change-me-please
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://sauron:change-me-please@db:5432/sauron_vision

# ── Redis (Celery broker + Channels layer + cache) ─────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Celery worker concurrency (tune per host) ──────────────────────────
CELERY_FAST_CONCURRENCY=4
CELERY_SLOW_CONCURRENCY=2

# ── Web port (host-side) ───────────────────────────────────────────────
WEB_PORT=8000

# ── External APIs ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# ── Notifications (Phase 20) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Email (for notify_channel=email + Django auth flows) ───────────────
DEFAULT_FROM_EMAIL=sauron@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Observability (optional) ───────────────────────────────────────────
SENTRY_DSN=
