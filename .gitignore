# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so

# Virtual environments
venv/
.venv/
env/

# Django
*.log
local_settings.py
db.sqlite3
# Leftover clones from `manage.py test --parallel` runs killed mid-flight —
# the runner names them default_<n> and cannot clean up after a crash.
default_*.sqlite3
media/
staticfiles/

# Environment
.env
.env.local
.env.production

# The Book of Sauron's staff-only chapter (core/views_book.py): read from
# private/ on a checkout, copied into the image, never committed.
/private/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node (frontend)
node_modules/
frontend/build/
frontend/dist/

# Celery
celerybeat-schedule
celerybeat.pid
# The filesystem:// broker settings.py falls back to without Redis (the
# test suite, CI, a dev box): its spool and kombu's control queue land in
# the repo root and are never source.
.celery/
control/

# Claude Code local state
.claude/

# Operator screenshots dropped locally — never ship into the public static root
static/screen/
.env.bak
.env.tmp
.env.lock
