# ============================================================
# SAURON VISION — Environment Variables
# Copy to .env and fill in your keys
# ============================================================

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (leave empty for SQLite in dev)
DATABASE_URL=

# Redis (leave empty for filesystem broker in dev)
REDIS_URL=

# ── AI Provider ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Hard daily ceiling on LLM spend in USD; 0 disables. Default 15 —
# sized for the COMPLETE AgentTask ledger (before 2026-08-24 the
# ledger missed every direct brain call and a 5 governed ~half of
# true spend).
AI_DAILY_BUDGET_USD=15

# ── Market Data APIs ─────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=

# ── eToro Integration (dual-key) ─────────────────────────
ETORO_PUBLIC_KEY=
ETORO_USER_KEY=

# ── Proxy & Scraping ────────────────────────────────────
SCRAPER_API_KEY=
SERP_API_KEY=
PROXY_LIST=

# ── Notifications ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email (for newsletters) ─────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sauron Vision <noreply@sauronvision.com>

# ── WhatsApp (Twilio) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Which optional services start ─────────────────────────────────────
# The streamers and the IB gateways are PROFILED services: `up -d` alone
# does not start them, and — the part that costs an afternoon — neither
# `logs` nor `ps` will even SEE them without the profile. A profiled
# service you forgot to enable looks exactly like a service that crashed
# silently: no output, no error, no container.
#
# Setting it here instead of typing --profile on every command is the
# difference. Compose reads COMPOSE_PROFILES from this file, so one line
# covers `up`, `logs`, `ps`, `restart` and everything else, and survives
# the next deploy.
#
#   COMPOSE_PROFILES=streamers            price feeds
#   COMPOSE_PROFILES=streamers,ibkr       feeds + one IB gateway
#
# Leave it empty to run the core stack only.
COMPOSE_PROFILES=

# UPGRADE-4 streamers
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# practice = demo account (the default and almost always right).
# Set `live` ONLY for a funded account's token — a demo token against the
# live host and a live token against practice both answer 401, which reads
# as a bad key.
OANDA_ENV=practice
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Interactive Brokers (optional; one profile per LOGIN) ─────────────
# IBKR has no API key: Gateway must be logged in and listening. Start the
# slots you have credentials for:
#
#   ./deploy/dc --profile ibkr --profile ibkr2 up -d
#
# and set each user's IBKRAccount host on the admin page to the matching
# service: ibgateway, ibgateway-2, … ibgateway-5.
#
# ONE SESSION PER USERNAME. Logging into the IBKR portal or mobile app
# with the same credentials kicks that Gateway out mid-session. Accounts
# UNDER a single login do NOT need separate slots — one Gateway serves
# them all and IBKRAccount.account_id decides where each order lands.
#
# TRADING_MODE decides which account Gateway logs into; the PORT on the
# admin form decides which one Sauron talks to. They must agree:
#   paper -> 4002        live -> 4001
#
# And give each IBKRAccount a DISTINCT client_id below 100 — Sauron
# derives one socket id per purpose from it, and IBKR evicts the earlier
# holder when two connections share an id.
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_TRADING_MODE=paper

IBKR2_USERNAME=
IBKR2_PASSWORD=
IBKR2_TRADING_MODE=paper

IBKR3_USERNAME=
IBKR3_PASSWORD=
IBKR3_TRADING_MODE=paper

IBKR4_USERNAME=
IBKR4_PASSWORD=
IBKR4_TRADING_MODE=paper

IBKR5_USERNAME=
IBKR5_PASSWORD=
IBKR5_TRADING_MODE=paper

# ---- TradingView alerts (optional) ------------------------------------
# Alerts arrive as SIGNALS, never as orders: they join the same queue
# every internal rule writes into, are scored and aged the same way, and
# are refused by the same book. Leave blank and the endpoint is CLOSED.
#
# TradingView cannot send custom headers, so this secret travels in the
# alert's JSON body. Point an alert at
#   https://<your-domain>/api/webhook/tradingview/
# with the message:
#   {"secret": "...", "symbol": "{{ticker}}", "action": "buy",
#    "price": {{close}}, "stop": 0, "target": 0, "strategy": "my-rule"}
TRADINGVIEW_WEBHOOK_SECRET=
