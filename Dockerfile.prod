# Production Dockerfile — multi-stage, non-root, no source bind-mount.
# Build:  docker build -f Dockerfile.prod -t sauron-vision:prod .
# Run:    via deploy/docker-compose.yml (see deploy/RUNBOOK.md)

# ── Build stage ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip wheel --no-cache-dir --wheel-dir=/build/wheels -r requirements.txt \
    && pip wheel --no-cache-dir --wheel-dir=/build/wheels gunicorn uvicorn[standard]


# ── Runtime stage ───────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings \
    PORT=8000

# Runtime libs only (no compilers).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system sauron \
    && useradd --system --gid sauron --create-home --home /home/sauron sauron

WORKDIR /app

COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels \
    -r /wheels/requirements.txt 2>/dev/null \
    || pip install --no-cache-dir --no-index --find-links=/wheels /wheels/*.whl \
    && rm -rf /wheels

COPY --chown=sauron:sauron . /app

# Compile Python bytecode to fail fast on syntax errors.
RUN python -m compileall -q /app/config /app/bot_program /app/signals \
    /app/dashboard /app/portfolio /app/instruments /app/market_data \
    /app/alerts /app/core /app/ai_agents 2>/dev/null || true

# Static files are baked into the image so every service shares them.
# Running collectstatic in the one-shot `migrate` service instead wrote them
# into a filesystem that is then discarded - `web` is a different container
# with an empty /app/staticfiles, so WhiteNoise found nothing and the whole
# app rendered as raw HTML behind a perfectly valid certificate.
#
# Runs offline: collectstatic touches no database. DB_ENGINE=sqlite matches
# the branch in settings.py exactly; any other spelling falls through to the
# auto-detect branch, which opens a TCP probe to a database host that does
# not exist yet on every single build.
RUN DJANGO_SETTINGS_MODULE=config.settings \
    SECRET_KEY=build-only-never-used-at-runtime \
    DEBUG=False DB_ENGINE=sqlite ALLOWED_HOSTS=localhost \
    python manage.py collectstatic --noinput

# After collectstatic, so this chown covers what it just wrote. Otherwise the
# tree is root-owned: WhiteNoise only reads it so the site works, but any
# later collectstatic run as `sauron` inside the container fails on EACCES.
RUN mkdir -p /app/staticfiles /app/media /app/logs \
    && chown -R sauron:sauron /app/staticfiles /app/media /app/logs

USER sauron

EXPOSE 8000

# NB: no image-level HEALTHCHECK. Every service is built from this image -
# the two Celery workers, beat and the five streamers included - and none of
# those serve HTTP, so an HTTP probe here marks all of them `unhealthy`
# forever and buries the one signal that matters. The web service declares
# its own healthcheck in deploy/docker-compose.yml.

# Default: ASGI server. Override in compose for celery worker / beat.
CMD ["gunicorn", "config.asgi:application", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--workers", "3", \
     "--bind", "0.0.0.0:8000", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--timeout", "120"]
