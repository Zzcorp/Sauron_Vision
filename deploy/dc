#!/usr/bin/env sh
# The compose wrapper — use this instead of typing `docker compose`.
#
#   ./deploy/dc up -d --build
#   ./deploy/dc logs -f web
#   ./deploy/dc exec web python manage.py seed_strategies
#
# WHY it exists: compose interpolates ${VAR} from the PROJECT directory,
# which with `-f deploy/docker-compose.yml` is deploy/ — not the repo root
# where .env lives. Omit --env-file and the very first command aborts with
#
#   required variable DB_PASSWORD is missing a value: DB_PASSWORD must be
#   set in .env
#
# while DB_PASSWORD is plainly set in .env. The flag is required on EVERY
# subcommand, which makes it exactly the kind of thing a hand-typed alias
# drops. Do NOT "fix" the same error with --project-directory . instead:
# that rebases `context: ..` and the ./Caddyfile mount and breaks the build.
set -e

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

if [ ! -f "$root/.env" ]; then
    echo "No .env at $root/.env — copy .env.example and fill it in first." >&2
    exit 1
fi

# THE BUILD STAMP (2026-09-13). Read here, from the checkout, because the
# image cannot read it for itself: .dockerignore excludes .git, so a
# container has no way to know which commit it is. That blindness cost a
# day — the box served the previous commit, two pages answered 404, and
# the only way to find out was probing the public site from outside.
#
# Exported unconditionally, not just on `build`: compose reads the
# environment when it interpolates, and a stamp that appeared on some
# subcommands and not others would be worse than none. `|| true` because
# a checkout without git, or a tarball deploy, must still be able to
# start the platform — it simply ships "unknown", which the page renders
# as an em dash rather than a sha nobody can check.
GIT_SHA=$(cd "$root" && git rev-parse --short HEAD 2>/dev/null) || true
BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || true
export GIT_SHA="${GIT_SHA:-unknown}"
export BUILT_AT="${BUILT_AT:-unknown}"

exec docker compose --env-file "$root/.env" -f "$here/docker-compose.yml" "$@"
